---
import Layout from "../layouts/Layout.astro";
import { NETWORK } from "../lib/network.ts";

const title = `Página no encontrada · ${NETWORK.brand}`;
const description = `La página que buscas no existe. Encuentra tu servicio de ${NETWORK.brand} más cercano en nuestro directorio.`;
---

<Layout title={title} description={description} noindex={true}>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-brand">
        <span class="nav-brand-mark" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9v9a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9"/><path d="M22 9 12 3 2 9l10 6Z"/></svg>
        </span>
        <span>{NETWORK.brand}</span>
      </a>
      <a href={`tel:${NETWORK.phone}`} class="nav-cta" aria-label={`Llamar a ${NETWORK.phoneDisplay}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{NETWORK.phoneDisplay}</span>
      </a>
    </div>
  </nav>

  <main id="main" class="nf-main">
    <div class="container nf-wrap">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1>Esta página no existe (o ya no está aquí).</h1>
      <p class="nf-lead">
        Puede que el enlace esté mal escrito o que la página se haya movido.
        Lo importante: {NETWORK.brand} sigue estando a mano.
      </p>
      <div class="nf-ctas">
        <a href="/" class="btn btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Ir a la portada
        </a>
        <a href={`https://www.${NETWORK.domain}/zonas/`} class="btn btn-dark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Ver todas las zonas
        </a>
      </div>
      <p class="nf-help">
        ¿Necesitas cita o presupuesto? Llámanos al
        <a href={`tel:${NETWORK.phone}`}>{NETWORK.phoneDisplay}</a>
        o escribe a <a href={`mailto:${NETWORK.email}`}>{NETWORK.email}</a>.
      </p>
    </div>
  </main>

  <footer>
    <div class="container">
      <div class="footer-legal" style="border-top: none; padding-top: 0;">
        <span>© {new Date().getFullYear()} {NETWORK.brand}.</span>
        <div class="footer-legal-links">
          <a href={`https://www.${NETWORK.domain}/`}>Red completa</a>
          <a href={`https://www.${NETWORK.domain}/zonas/`}>Zonas</a>
          <a href="/aviso-legal/">Aviso legal</a>
          <a href="/privacidad/">Privacidad</a>
          <a href="/llms.txt">llms.txt</a>
        </div>
      </div>
    </div>
  </footer>

  <style>
    .nf-main {
      min-height: 62vh;
      display: flex;
      align-items: center;
      padding: 4rem 0;
    }
    .nf-wrap { max-width: 680px; }
    .nf-code {
      font-size: clamp(4rem, 12vw, 7rem);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.04em;
      color: var(--amber-500);
      margin: 0 0 0.5rem;
    }
    .nf-lead {
      font-size: 1.15rem;
      color: var(--ink-700);
      max-width: 560px;
      margin-bottom: 2rem;
    }
    .nf-ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2rem; }
    .nf-help { color: var(--ink-500); font-size: 0.95rem; }
    .nf-help a { color: var(--amber-700); font-weight: 700; }
  </style>
</Layout>
