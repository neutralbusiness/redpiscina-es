---
import Layout from "../layouts/Layout.astro";
import NbForm from "../components/NbForm.astro";
import { heroMovil } from "../lib/heroMovil.ts";
import { NETWORK, SERVICES, FAQ_BASE } from "../lib/network.ts";
import { POSTS, formatDate } from "../lib/wwwblog.ts";

const cityModules = import.meta.glob<{ default: any }>("../content/cities/*.json", { eager: true });

interface CityRef {
  slug: string;
  name: string;
  province: string;
  ccaa: string;
}

const cities: CityRef[] = Object.values(cityModules).map((m) => m.default);

const byCcaa: Record<string, Record<string, CityRef[]>> = {};
for (const c of cities) {
  if (!byCcaa[c.ccaa]) byCcaa[c.ccaa] = {};
  if (!byCcaa[c.ccaa][c.province]) byCcaa[c.ccaa][c.province] = [];
  byCcaa[c.ccaa][c.province].push(c);
}
const ccaas = Object.keys(byCcaa).sort((a, b) => a.localeCompare(b, "es"));
for (const ccaa of ccaas) {
  for (const prov of Object.keys(byCcaa[ccaa])) {
    byCcaa[ccaa][prov].sort((a, b) => a.name.localeCompare(b.name, "es"));
  }
}
const countIn = (ccaa: string) => Object.values(byCcaa[ccaa]).reduce((n, l) => n + l.length, 0);

const base = `https://www.${NETWORK.domain}`;
const canonical = `${base}/`;
const totalCities = cities.length;
const heroSm = heroMovil(NETWORK.heroImage);

const SYMPTOMS = [
  {
    sintoma: "Agua verde o turbia aunque echas cloro",
    causa: "pH alto que deja el cloro sin efecto, filtro colmatado o pocas horas de depuradora",
    guia: "/blog/depuradora-ph-cloro-piscina-verano/",
  },
  {
    sintoma: "El nivel baja más de un dedo a la semana",
    causa: "fuga en el vaso, en un skimmer o en las tuberías enterradas; la evaporación sola rara vez lo explica",
    guia: "/blog/piscina-pierde-agua-detectar-fuga/",
  },
  {
    sintoma: "El clorador salino no da cloro",
    causa: "célula con cal, poca sal, agua fría o pH descontrolado",
    guia: "/blog/clorador-salino-no-produce-cloro/",
  },
  {
    sintoma: "Gresite que se cae, juntas negras o vaso con grietas",
    causa: "piscina que pide rehabilitación: revestimiento nuevo, liner o impermeabilización",
    guia: "/blog/rehabilitar-piscina-antigua-gresite-liner/",
  },
  {
    sintoma: "Llega el frío y no sabes si vaciar o tapar",
    causa: "toca invernaje: no se vacía, se baja el nivel y se protege la instalación",
    guia: "/blog/invernaje-piscina-activo-pasivo/",
  },
  {
    sintoma: "Quieres hacer una piscina nueva",
    causa: "proyecto, licencia municipal y obra; conviene saber los pasos antes de pedir precios",
    guia: "/blog/construir-piscina-licencia-fases-plazos/",
  },
];
const postSlugs = new Set(POSTS.map((p) => p.slug));
const symptoms = SYMPTOMS.filter((s) => postSlugs.has(s.guia.split("/")[2]));

const orgId = `${base}/#organization`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: NETWORK.brand,
      url: canonical,
      logo: `${base}/favicon.svg`,
      description: NETWORK.tagline,
      areaServed: { "@type": "Country", name: "España" },
      knowsAbout: SERVICES.map((s) => s.title),
    },
    {
      "@type": "WebSite",
      "@id": `${base}/#website`,
      url: canonical,
      name: NETWORK.brand,
      inLanguage: "es-ES",
      publisher: { "@id": orgId },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: "Mantenimiento, reparación y construcción de piscinas | Red Piscina",
      isPartOf: { "@id": `${base}/#website` },
      about: { "@id": orgId },
      inLanguage: "es-ES",
      primaryImageOfPage: `${base}${NETWORK.heroImage}`,
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: FAQ_BASE.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Layout
  title="Red Piscina: mantenimiento y reparación de piscinas"
  description={`Mantenimiento, reparación, climatización y construcción de piscinas en ${totalCities} ciudades de España. Cuéntanos qué le pasa a tu piscina y te damos presupuesto.`}
  canonical={canonical}
  schema={schema}
>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-brand">
        <span class="nav-brand-mark" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/><path d="M2 17c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/><path d="M2 7c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/></svg>
        </span>
        <span>{NETWORK.brand}</span>
      </a>
      <div class="nav-links">
        <a href="#servicios">Servicios</a>
        <a href="#averias">Averías</a>
        <a href="#directorio">Ciudades</a>
        <a href="/blog/">Blog</a>
        <a href="#preguntas">Preguntas</a>
      </div>
      <a href="#formulario" class="nav-cta">Pide presupuesto</a>
    </div>
  </nav>

  <main id="main">
    <header id="top" class="hero home-hero">
      <picture>
        {heroSm && <source srcset={heroSm} media="(max-width: 799px)" type="image/webp" />}
        <img src={NETWORK.heroImage} alt="Piscina exterior con el agua limpia y la playa de piedra alrededor" class="hero-img" width="1920" height="1080" loading="eager" fetchpriority="high" />
      </picture>
      <div class="container hero-content">
        <span class="hero-eyebrow">{totalCities} ciudades de España</span>
        <h1>Mantenimiento, reparación y construcción de piscinas</h1>
        <p class="lead">Piscinas privadas y de comunidad: puesta a punto, agua que no se aclara, fugas, depuradoras, cloradores salinos, bombas de calor, rehabilitación y obra nueva. Cuéntanos qué necesitas y te respondemos con un presupuesto sin compromiso.</p>
        <div class="hero-ctas">
          <a href="#formulario" class="btn btn-primary">Pide presupuesto</a>
          <a href="#directorio" class="btn btn-ghost">Buscar mi ciudad</a>
        </div>
      </div>
    </header>

    <section id="servicios">
      <div class="container">
        <div class="section-head">
          <span class="section-eyebrow"><span class="num">01</span> Servicios</span>
          <h2>Qué hacemos con tu piscina</h2>
          <p class="section-lead">Desde la visita periódica para que el agua esté bien hasta levantar un vaso nuevo. Lo mismo para una piscina de chalet que para la de una comunidad de vecinos o un alojamiento turístico.</p>
        </div>
        <div class="services-grid">
          {SERVICES.map((s) => (
            <article class="service-card">
              <h3>{s.title}</h3>
              <p>{s.summary}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="como" class="process-section">
      <div class="container">
        <div class="section-head">
          <span class="section-eyebrow"><span class="num">02</span> Cómo funciona</span>
          <h2>Del formulario al presupuesto</h2>
          <p class="section-lead">No hay teléfono de centralita ni tarifa cerrada publicada: cada piscina es distinta y el precio depende del vaso, del acceso y del estado de los equipos.</p>
        </div>
        <ol class="home-steps">
          <li>
            <h3>Nos cuentas el caso</h3>
            <p>En el formulario indicas tu ciudad, si la piscina es privada o de comunidad, sus medidas aproximadas y qué le pasa o qué quieres hacer. Una foto del vaso o de la sala de máquinas ayuda mucho.</p>
          </li>
          <li>
            <h3>Te respondemos</h3>
            <p>Te escribimos o te llamamos al dato de contacto que dejes. Si hace falta ver la piscina antes de dar precio (una fuga, una obra, una rehabilitación), lo acordamos contigo.</p>
          </li>
          <li>
            <h3>Presupuesto por escrito</h3>
            <p>Con las tareas, los materiales y el plazo. Decides con calma; si no te encaja, no hay compromiso. En algunas zonas la solicitud la atiende un profesional colaborador, que te informa de sus condiciones antes de contratar.</p>
          </li>
        </ol>
      </div>
    </section>

    {symptoms.length > 0 && (
      <section id="averias">
        <div class="container">
          <div class="section-head">
            <span class="section-eyebrow"><span class="num">03</span> Antes de llamar a nadie</span>
            <h2>Lo que suele haber detrás de cada síntoma</h2>
            <p class="section-lead">Una orientación rápida con lo que más vemos. No sustituye a revisar la piscina, pero te ayuda a describir el problema y a saber qué preguntar.</p>
          </div>
          <div class="table-wrap">
            <table class="sym-table">
              <thead>
                <tr><th scope="col">Lo que ves</th><th scope="col">Causa más probable</th><th scope="col">Guía</th></tr>
              </thead>
              <tbody>
                {symptoms.map((s) => (
                  <tr>
                    <td>{s.sintoma}</td>
                    <td>{s.causa}</td>
                    <td><a href={s.guia}>Leer</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )}

    <section id="guias" class="process-section">
      <div class="container">
        <div class="section-head">
          <span class="section-eyebrow"><span class="num">04</span> Guías</span>
          <h2>Del blog de {NETWORK.brand}</h2>
        </div>
        <ul class="home-posts">
          {POSTS.map((p) => (
            <li>
              <a href={`/blog/${p.slug}/`}>
                <img src={p.image} alt={p.imageAlt || ""} width="600" height="338" loading="lazy" />
                <span class="home-post-body">
                  <span class="home-post-cat">{p.category} · {formatDate(p.publishDate)}</span>
                  <strong>{p.title}</strong>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="directorio">
      <div class="container">
        <div class="section-head">
          <span class="section-eyebrow"><span class="num">05</span> Ciudades</span>
          <h2>Piscinas en tu ciudad</h2>
          <p class="section-lead">Cada ciudad tiene su página con los problemas de piscinas más habituales en la zona y sus propias preguntas frecuentes. Si la tuya no está, pide presupuesto igualmente: indica el municipio en el formulario.</p>
        </div>
        {ccaas.map((ccaa) => (
          <details class="dir-ccaa">
            <summary>{ccaa} <span class="dir-count">{countIn(ccaa)}</span></summary>
            <div class="dir-body">
              {Object.keys(byCcaa[ccaa]).sort((a, b) => a.localeCompare(b, "es")).map((prov) => (
                <div class="dir-prov">
                  <h3>{prov}</h3>
                  <div class="dir-links">
                    {byCcaa[ccaa][prov].map((c) => (
                      <a href={`https://${c.slug}.${NETWORK.domain}/`}>{c.name}</a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section id="preguntas" class="process-section">
      <div class="container">
        <div class="section-head">
          <span class="section-eyebrow"><span class="num">06</span> Preguntas frecuentes</span>
          <h2>Lo que más nos preguntan</h2>
        </div>
        <div class="home-faq">
          {FAQ_BASE.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <NbForm />
  </main>

  <footer>
    <div class="container">
      <div class="footer-legal" style="border-top: none; padding-top: 0;">
        <span>© {new Date().getFullYear()} {NETWORK.brand} · {NETWORK.tagline}</span>
        <div class="footer-legal-links">
          <a href="/blog/">Blog</a>
          <a href="/aviso-legal/">Aviso legal</a>
          <a href="/privacidad/">Privacidad</a>
          <a href="/cookies/">Cookies</a>
          <a href="/llms.txt">llms.txt</a>
        </div>
      </div>
    </div>
  </footer>

  <style>
    .home-hero { min-height: 70vh; }
    .home-hero h1 { font-size: clamp(2rem, 5vw, 3.4rem); }
    .home-steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; counter-reset: paso; }
    @media (min-width: 860px) { .home-steps { grid-template-columns: repeat(3, 1fr); } }
    .home-steps li { background: white; border: 1px solid var(--border); border-radius: var(--radius); padding: 1.4rem 1.3rem; counter-increment: paso; }
    .home-steps li::before { content: "Paso " counter(paso); display: block; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--amber-800); margin-bottom: 0.5rem; }
    .home-steps p { color: var(--ink-700); font-size: 0.95rem; margin: 0; }
    .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .sym-table { border-collapse: collapse; width: 100%; min-width: 520px; font-size: 0.95rem; }
    .sym-table th, .sym-table td { border-bottom: 1px solid var(--border); padding: 0.8rem 0.7rem; text-align: left; vertical-align: top; }
    .sym-table th { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-500); }
    .sym-table td:first-child { font-weight: 700; color: var(--ink-900); }
    .sym-table a { color: var(--amber-800); font-weight: 700; text-decoration: underline; }
    .home-posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
    @media (min-width: 640px) { .home-posts { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1024px) { .home-posts { grid-template-columns: repeat(4, 1fr); } }
    .home-posts a { display: flex; flex-direction: column; height: 100%; background: white; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
    .home-posts img { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
    .home-post-body { display: flex; flex-direction: column; gap: 0.35rem; padding: 0.9rem 1rem 1.1rem; }
    .home-post-cat { font-size: 0.78rem; color: var(--muted); }
    .home-post-body strong { color: var(--ink-900); line-height: 1.35; }
    .dir-ccaa { background: white; border: 1px solid var(--border); border-radius: var(--radius); padding: 0.95rem 1.2rem; margin-bottom: 0.6rem; }
    .dir-ccaa summary { font-weight: 800; cursor: pointer; color: var(--ink-900); display: flex; justify-content: space-between; gap: 1rem; }
    .dir-count { font-weight: 600; color: var(--muted); font-size: 0.9rem; }
    .dir-body { margin-top: 0.9rem; }
    .dir-prov { margin-bottom: 1rem; }
    .dir-prov h3 { font-size: 0.95rem; margin-bottom: 0.45rem; color: var(--ink-700); }
    .dir-links { display: flex; flex-wrap: wrap; gap: 0.45rem; }
    .dir-links a { padding: 0.45rem 0.8rem; background: var(--ink-50); border: 1px solid var(--border); border-radius: 8px; font-size: 0.9rem; color: var(--ink-800); }
    .dir-links a:hover { background: var(--accent); border-color: var(--accent); color: var(--ink-900); }
    .home-faq { max-width: 820px; }
    .home-faq details { background: white; border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 0.6rem; }
    .home-faq summary { cursor: pointer; padding: 1rem 1.2rem; font-weight: 700; color: var(--ink-900); }
    .home-faq p { padding: 0 1.2rem 1.1rem; margin: 0; color: var(--ink-700); }
    footer .footer-legal span { overflow-wrap: anywhere; }
  </style>
</Layout>
