---
import Layout from "../../layouts/Layout.astro";
import { NETWORK } from "../../lib/network.ts";
import { POSTS, bodyFor, formatDate, type WwwPost } from "../../lib/wwwblog.ts";
import { BLOG_TEXT } from "../../lib/wwwblog-text.ts";

export function getStaticPaths() {
  return POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: WwwPost };
const { frontmatter, Content } = bodyFor(post.slug);

const base = `https://www.${NETWORK.domain}`;
const canonical = `${base}/blog/${post.slug}/`;
const image = `${base}${post.image}`;
const others = POSTS.filter((p) => p.slug !== post.slug);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: frontmatter.metaDescription || post.excerpt,
    image,
    datePublished: post.publishDate,
    dateModified: post.publishDate,
    author: { "@type": "Organization", name: post.author || NETWORK.brand, url: `${base}/` },
    publisher: { "@type": "Organization", name: NETWORK.brand, url: `${base}/` },
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    inLanguage: "es-ES",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${base}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${base}/blog/` },
      { "@type": "ListItem", position: 3, name: post.title, item: canonical },
    ],
  },
];
---

<Layout
  title={frontmatter.metaTitle || post.title}
  description={frontmatter.metaDescription || post.excerpt}
  canonical={canonical}
  schema={schema}
  ogImage={image}
>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-brand">{NETWORK.brand}</a>
      <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/#directorio">Directorio</a>
        <a href="/blog/">Blog</a>
        <a href={`tel:${NETWORK.phone}`}>{NETWORK.phoneDisplay}</a>
      </div>
    </div>
  </nav>

  <article>
    <header class="wa-head">
      <div class="container">
        <p class="wa-crumbs"><a href="/">Inicio</a> › <a href="/blog/">Blog</a></p>
        <p class="wa-meta">
          <span class="wa-cat">{post.category}</span>
          <time datetime={post.publishDate}>{formatDate(post.publishDate)}</time>
          <span>· {post.readTime} min de lectura</span>
        </p>
        <h1>{post.title}</h1>
        <p class="wa-lead">{post.excerpt}</p>
      </div>
    </header>

    <div class="container">
      <img src={post.image} alt={post.title} class="wa-img" width="1200" height="675" />
      <div class="wa-body">
        <Content />
      </div>
      <aside class="wa-cta">
        <p><strong>{BLOG_TEXT.articleCtaTitle}</strong> {BLOG_TEXT.articleCtaText}</p>
        <p><a href="/#directorio">Buscar mi ciudad en el directorio →</a> · <a href={`tel:${NETWORK.phone}`}>{NETWORK.phoneDisplay}</a></p>
      </aside>
      {others.length > 0 && (
        <nav class="wa-more" aria-label="Más artículos">
          <h2>Más en el blog</h2>
          <ul>
            {others.map((p) => <li><a href={`/blog/${p.slug}/`}>{p.title}</a></li>)}
          </ul>
        </nav>
      )}
    </div>
  </article>

  <footer>
    <div class="container">
      <p style="margin: 0; color: white; font-weight: 700;">{NETWORK.brand}</p>
      <p style="margin: 0.5rem 0; font-size: 0.85rem;">{BLOG_TEXT.footerLine} · {NETWORK.email}</p>
      <p style="margin: 0.5rem 0 0; font-size: 0.8rem;"><a href="/blog/" style="color: rgba(255,255,255,0.6);">Blog</a> · <a href="/llms.txt" style="color: rgba(255,255,255,0.6);">llms.txt</a></p>
    </div>
  </footer>

<!-- formulario-neutralb -->
<section class="nb-form-sec" style="padding:clamp(2.5rem,6vw,4.5rem) 1.2rem">
  <div style="max-width:1100px;margin-inline:auto"><div data-nb-form></div></div>
</section>
<script defer src="https://panel.neutralb.es/formulario.js"></script>
<!-- /formulario-neutralb -->

  <style>
    .wa-head { background: var(--surface-alt); border-bottom: 1px solid var(--border); padding: 2.5rem 0 1.75rem; }
    .wa-head h1 { font-size: clamp(1.8rem, 4vw, 2.7rem); margin: 0.6rem 0; }
    .wa-crumbs { font-size: 0.88rem; color: var(--muted); margin: 0 0 0.6rem; }
    .wa-crumbs a { color: var(--ink-700); text-decoration: underline; }
    .wa-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; color: var(--muted); font-size: 0.85rem; margin: 0; }
    .wa-cat { background: var(--amber-100); color: var(--amber-800); padding: 0.1rem 0.6rem; border-radius: 999px; font-weight: 600; font-size: 0.75rem; }
    .wa-lead { font-size: 1.1rem; color: var(--ink-700); margin: 0; }
    .wa-img { width: 100%; max-width: 820px; height: auto; border-radius: 12px; margin: 2rem 0 1rem; }
    .wa-body { max-width: 720px; font-size: 1.05rem; line-height: 1.75; }
    .wa-body :global(h2) { font-size: 1.55rem; margin: 2.2rem 0 0.8rem; }
    .wa-body :global(h3) { font-size: 1.2rem; margin: 1.6rem 0 0.6rem; }
    .wa-body :global(p) { margin: 0 0 1.1em; }
    .wa-body :global(ul), .wa-body :global(ol) { padding-left: 1.4rem; margin: 0 0 1.1em; }
    .wa-body :global(li) { margin: 0.35em 0; }
    .wa-body :global(a) { color: var(--amber-800); text-decoration: underline; }
    .wa-body :global(table) { border-collapse: collapse; width: 100%; font-size: 0.95rem; margin: 0 0 1.2em; display: block; overflow-x: auto; }
    .wa-body :global(th), .wa-body :global(td) { border: 1px solid var(--border); padding: 0.5rem 0.7rem; text-align: left; vertical-align: top; }
    .wa-body :global(th) { background: var(--surface-alt); }
    .wa-body :global(blockquote) { border-left: 3px solid var(--amber-500); margin: 1.4em 0; padding: 0.2rem 0 0.2rem 1rem; color: var(--ink-700); }
    .wa-cta { max-width: 720px; background: white; border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; padding: 1.25rem 1.4rem; margin: 2.5rem 0 1.5rem; }
    .wa-cta p { margin: 0 0 0.5rem; }
    .wa-cta a { color: var(--amber-800); font-weight: 700; }
    .wa-more { max-width: 720px; margin: 0 0 3rem; }
    .wa-more h2 { font-size: 1.2rem; }
    .wa-more a { color: var(--ink-800); text-decoration: underline; }
  </style>
</Layout>
