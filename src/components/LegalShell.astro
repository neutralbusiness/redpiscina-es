---
import Layout from "../layouts/Layout.astro";
import { NETWORK } from "../lib/network.ts";

/**
 * Shell compartido de las páginas legales (/aviso-legal/ y /privacidad/).
 * Estas páginas se sirven idénticas en el master (www) y en todos los
 * subdominios de ciudad (el middleware reescribe esas rutas al master),
 * por eso el canonical apunta SIEMPRE a www: consolida las ~561 copias.
 */
interface Props {
  title: string;
  description: string;
  /** path con barras, p.ej. "/aviso-legal/" */
  path: string;
  /** encabezado H1 visible */
  heading: string;
}

const { title, description, path, heading } = Astro.props;
const canonical = `https://www.${NETWORK.domain}${path}`;
---

<Layout title={title} description={description} canonical={canonical}>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-brand">
        <span class="nav-brand-mark" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9v9a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9"/><path d="M22 9 12 3 2 9l10 6Z"/></svg>
        </span>
        <span>{NETWORK.brand}</span>
      </a>
      <a href={`tel:${NETWORK.phone}`} class="nav-cta" aria-label={`Llamar a ${NETWORK.phoneDisplay}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{NETWORK.phoneDisplay}</span>
      </a>
    </div>
  </nav>

  <main id="main" class="legal-main">
    <div class="container">
      <article class="legal-article">
        <h1>{heading}</h1>
        <slot />
      </article>
    </div>
  </main>

  <footer>
    <div class="container">
      <div class="footer-legal" style="border-top: none; padding-top: 0;">
        <span>© {new Date().getFullYear()} {NETWORK.brand} · {NETWORK.email}</span>
        <div class="footer-legal-links">
          <a href={`https://www.${NETWORK.domain}/`}>Inicio</a>
          <a href={`https://www.${NETWORK.domain}/zonas/`}>Zonas</a>
          <a href="/aviso-legal/">Aviso legal</a>
          <a href="/privacidad/">Privacidad</a>
          <a href="/llms.txt">llms.txt</a>
        </div>
      </div>
    </div>
  </footer>

  <style is:global>
    .legal-main { padding: 3.5rem 0 5rem; }
    .legal-article { max-width: 760px; }
    .legal-article h1 { margin-bottom: 1.5rem; font-size: clamp(1.9rem, 4vw, 2.6rem); }
    .legal-article h2 {
      font-size: 1.3rem;
      margin: 2.25rem 0 0.75rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
    }
    .legal-article p, .legal-article li { color: var(--ink-700); line-height: 1.7; }
    .legal-article ul { margin: 0 0 1em; }
    .legal-article li { margin-bottom: 0.35rem; }
    .legal-article a { color: var(--amber-700); font-weight: 600; }
    .legal-updated { color: var(--ink-500); font-size: 0.88rem; margin-bottom: 2rem; }
    .legal-pending {
      background: var(--amber-100);
      color: var(--amber-800);
      font-weight: 700;
      padding: 0.05rem 0.35rem;
      border-radius: 4px;
      white-space: nowrap;
    }
  </style>
</Layout>
